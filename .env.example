# MongoDB connection string
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority"

# JWT signing secret (use a long random string)
JWT_SECRET="replace_with_long_random_secret"

# Brevo (Sendinblue) API key for transactional emails
BREVO_API_KEY="replace_with_brevo_api_key"

# SMTP fallback credentials (if used)
EMAIL_USER="your_email@example.com"
EMAIL_PASS="your_email_app_password"

# Server settings
PORT=8080
NODE_ENV=development

# Frontend/CORS settings
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"


GEMINI_API_KEY="Google KEY"
GEMINI_EMBED_MODEL="gemini-embedding-001"
GEMINI_CHAT_MODEL="gemini-3.6-flash"